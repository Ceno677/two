# Core infrastructure
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/directional_fees"
REDIS_URL="redis://localhost:6379"
SOLANA_RPC_URL="https://YOUR_PRIMARY_MAINNET_RPC"
SOLANA_WS_URL="wss://YOUR_PRIMARY_MAINNET_WEBSOCKET"
SOLANA_BACKUP_RPC_URL="https://YOUR_BACKUP_MAINNET_RPC"
SOLANA_BACKUP_WS_URL="wss://YOUR_BACKUP_MAINNET_WEBSOCKET"

# Set only after deploying and verifying the Anchor program
DIRECTIONAL_FEE_PROGRAM_ID=""

# Solana-native fee conversion
JUPITER_API_URL="https://lite-api.jup.ag/swap/v1"
JUPITER_API_KEY=""

# Token image + metadata pinning
PINATA_JWT=""
PINATA_GATEWAY="https://gateway.pinata.cloud/ipfs"

# Keeper: path on the keeper host; never commit the keypair file
KEEPER_KEYPAIR_PATH=""
INTERNAL_ROUTE_SECRET="replace-with-32-plus-random-characters"

# Economics and safety
PROTOCOL_SHARE_BPS="500"
DEFAULT_ROUTING_THRESHOLD_LAMPORTS="50000000"
DEFAULT_MAX_BATCH_INTERVAL_SECONDS="1800"
DEFAULT_MAX_SLIPPAGE_BPS="100"

# Phase 2 only
NEAR_INTENTS_JWT=""

# App and monitoring
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SENTRY_DSN=""
